{
  "name": "server-monitor",
  "private": true,
  "version": "0.4.0",
  "description": "Paseo 插件：多 VPS 监控面板（CPU/内存/磁盘/网络，SSH 采集）；SSH 连接复用 + 离线退避，低开销；密码 AES-256-GCM 本地加密；附带 manage.mjs CLI。要求 Paseo >= 0.8.0。",
  "license": "MIT",
  "keywords": ["paseo", "plugin", "server", "monitor", "vps", "ssh", "metrics"],
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@getpaseo/plugin": "0.8.0",
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "^22.0.0",
    "@types/react": "~19.2.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  }
}
